---
export type Project = {
  name: string;
  description?: string;
  github?: string;
  website?: string;
};

type Props = {
  project: Project;
};

const { project } = Astro.props;
const primaryLink = project.website || project.github;
---

<div class="group flex items-baseline gap-2 py-1.5 -mx-3 px-3 rounded hover:bg-ink-600/[0.03] dark:hover:bg-cream-50/[0.03] transition-colors duration-300">
  {primaryLink ? (
    <a
      href={primaryLink}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium text-ink-500 dark:text-cream-100 hover:text-terracotta dark:hover:text-terracotta-light transition-colors duration-300"
    >
      {project.name}
    </a>
  ) : (
    <span class="text-sm font-medium text-ink-500 dark:text-cream-100">
      {project.name}
    </span>
  )}
  {project.description && (
    <span class="text-xs text-ink-100 dark:text-cream-300/40 ml-2">
      {project.description}
    </span>
  )}
</div>
