---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex items-baseline justify-between gap-4">
      <a href="/" class="group">
        <h1 class="text-xl md:text-2xl font-bold text-ink-600 dark:text-cream-50 tracking-tight transition-colors duration-300">
          {SITE.NAME}
        </h1>
      </a>
      <nav class="flex items-center gap-4 text-sm">
        <a
          href="https://x.com/figelwump"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-200 dark:text-cream-300 hover:text-terracotta dark:hover:text-terracotta-light transition-colors duration-300"
        >
          twitter
        </a>
        <a
          href="https://github.com/figelwump"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-200 dark:text-cream-300 hover:text-terracotta dark:hover:text-terracotta-light transition-colors duration-300"
        >
          github
        </a>
      </nav>
    </div>
  </Container>
</header>
