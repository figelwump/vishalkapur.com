---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  underline?: boolean;
}

const { href, external, underline = true, ...rest } = Astro.props;
---

<a
  href={href}
  target={ external ? "_blank" : "_self" }
  class={cn(
    "inline-block text-ink-300 dark:text-cream-300",
    "hover:text-terracotta dark:hover:text-terracotta-light",
    "transition-colors duration-300 ease-in-out",
    underline && "underline underline-offset-2 decoration-ink-100/30 dark:decoration-cream-300/20 hover:decoration-terracotta/40 dark:hover:decoration-terracotta-light/40"
  )}
  {...rest}>
  <slot/>
</a>
