---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const href = entry.collection === 'blog' ? `/posts/${entry.slug}` : `/${entry.collection}/${entry.slug}`;

const date = entry.data.date;
const month = date.toLocaleDateString("en-us", { month: "short" });
const year = date.getFullYear();
---

<a href={href} class="group flex items-baseline gap-2 py-1.5 -mx-3 px-3 rounded hover:bg-ink-600/[0.03] dark:hover:bg-cream-50/[0.03] transition-colors duration-300">
  <span class="text-sm font-medium text-ink-500 dark:text-cream-100 group-hover:text-terracotta dark:group-hover:text-terracotta-light transition-colors duration-300">
    {entry.data.title}
  </span>
  <span class="text-xs text-ink-100 dark:text-cream-300/40 whitespace-nowrap tabular-nums ml-2">
    {month} {year}
  </span>
</a>
