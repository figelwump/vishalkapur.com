---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const href = entry.collection === 'blog' ? `/posts/${entry.slug}` : `/${entry.collection}/${entry.slug}`;

const date = entry.data.date;
const month = date.toLocaleDateString("en-us", { month: "short" });
const year = date.getFullYear();
---

<a href={href} class="group block py-3 -mx-3 px-3 rounded-lg hover:bg-ink-600/[0.03] dark:hover:bg-cream-50/[0.03] transition-colors duration-300">
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="text-sm font-medium text-ink-500 dark:text-cream-100 group-hover:text-terracotta dark:group-hover:text-terracotta-light transition-colors duration-300">
        {entry.data.title}
      </div>
      <div class="text-xs text-ink-200 dark:text-cream-300/60 mt-0.5 truncate">
        {entry.data.description}
      </div>
    </div>
    <div class="text-xs text-ink-100 dark:text-cream-300/40 whitespace-nowrap pt-0.5 tabular-nums">
      {month} {year}
    </div>
  </div>
</a>
