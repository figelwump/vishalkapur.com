---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import type { Project } from "@components/ProjectCard.astro";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter(post => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
}

const posts = data.reduce((acc: Acc, post) => {
    const year = post.data.date.getFullYear().toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  }, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

const projects: Project[] = [
  {
    name: "toastty",
    description: "native mac terminal manager built on ghostty",
    website: "https://toastty.dev",
  },
  {
    name: "redline",
    description: "chrome extension to simplify UI feedback for agents",
    github: "https://github.com/figelwump/redline",
  },
  {
    name: "sv",
    description: "simple secret vault for agents",
    github: "https://github.com/figelwump/sv",
  },
  {
    name: "travel-agent",
    description: "travel planning agent",
    github: "https://github.com/figelwump/travel-agent",
  },
  {
    name: "fin-agent",
    description: "personal finance agent",
    github: "https://github.com/figelwump/fin-agent",
  },
];
---

<PageLayout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div class="space-y-14">

      <!-- Intro -->
      <section class="opacity-0 animate-fade-in stagger-1">
        <p class="text-sm leading-relaxed text-ink-300 dark:text-cream-300">
          I'm an engineer and entrepreneur. Currently building things for the fun of it.
        </p>
      </section>

      <!-- Projects -->
      <section class="opacity-0 animate-fade-in stagger-2">
        <div class="flex items-center gap-4 mb-4">
          <h2 class="text-xs font-medium uppercase tracking-[0.15em] text-ink-100 dark:text-cream-300/40">
            Projects
          </h2>
          <div class="flex-1 h-px bg-ink-100/15 dark:bg-cream-300/8"></div>
        </div>
        <div>
          {projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>

      <!-- Writing -->
      <section class="opacity-0 animate-fade-in stagger-3">
        <div class="flex items-center gap-4 mb-4">
          <h2 class="text-xs font-medium uppercase tracking-[0.15em] text-ink-100 dark:text-cream-300/40">
            Writing
          </h2>
          <div class="flex-1 h-px bg-ink-100/15 dark:bg-cream-300/8"></div>
        </div>
        <div>
          {data.map((post) => (
            <ArrowCard entry={post}/>
          ))}
        </div>
      </section>

    </div>
  </Container>
</PageLayout>
