---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => import.meta.env.DEV || !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="opacity-0 animate-fade-in stagger-1">
      <BackToPrev href="/">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10 opacity-0 animate-fade-in stagger-2">
      <div class="flex items-center gap-1.5 text-sm text-ink-200 dark:text-cream-300/50">
        <FormattedDate date={post.data.date} />
        &bull;
        <span>{readingTime(post.body)}</span>
      </div>
      <h1 class="text-xl md:text-2xl font-bold text-ink-600 dark:text-cream-50 tracking-tight">
        {post.data.title}
      </h1>
    </div>
    <div class="opacity-0 animate-fade-in stagger-3">
      <article>
        <Content />
      </article>
    </div>
  </Container>
</PageLayout>
